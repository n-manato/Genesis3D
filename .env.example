# ---- Genesis3D environment ----
# Copy to ".env" and adjust. Never commit a real ".env".

# --- Genesis3D orchestrator ---
GENESIS_HOST=127.0.0.1   # localhost only. Do NOT expose externally.
GENESIS_PORT=8820   # 8801=motion, 8802-8804=gesture, 8811=trellis, 8000=sidecar
GENESIS_DATA_DIR=./jobs
GENESIS_LOG_DIR=./logs

# --- AICCORE-Nexus Gateway ---
# Genesis3D runs standalone without these; they are only used to push job events
# back to the Gateway. Leave GATEWAY_API_KEY empty to disable callbacks.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
GATEWAY_API_KEY=
GATEWAY_EVENT_PATH=/v1/3d/characters/events

# --- Existing TRELLIS.2 service (reused, not reinstalled) ---
# Started/stopped by the Gateway's Model Runtime page, or AICCORE-Nexus/trellis-service/run.sh
TRELLIS_HOST=http://127.0.0.1:8811

# --- Blender ---
BLENDER_BIN=~/opt/blender/blender

# --- conda ---
CONDA_BASE=~/miniconda3
ENV_GENESIS=genesis
ENV_UNIRIG=unirig
ENV_CHARACTERGEN=charactergen
ENV_IMAGEGEN=
# 参照ビュー生成(工程2)。SDXL + ControlNet-OpenPose。envs/setup_imagegen.sh で作る
ENV_EVAL=genesis-eval

# --- GPU policy ---
# Genesis3D owns GPU0. GPU1 is reached only over HTTP (:8811) because TRELLIS.2
# is pinned resident there with ~7GB free — never load a new model onto GPU1.
GENESIS_GPU=0
GPU_VRAM_RESERVE_GB=2   # matches the Gateway's GPU_VRAM_RESERVE_GB

# --- Offline ---
# After the first weight download, keep generation fully offline.
HF_HUB_OFFLINE=1

# --- Retention (disk is the binding constraint: ~48GB total budget) ---
JOB_RETENTION_COMPLETED_DAYS=7
JOB_RETENTION_FAILED_DAYS=14
JOB_WORKSPACE_MAX_GB=10

# --- リギング用テンプレート（UniRig 導入までの経路） ---
RIG_TEMPLATE_VRM=
ENV_FACE=
